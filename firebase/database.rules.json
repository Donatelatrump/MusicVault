{
  "rules": {
    ".read": false,
    ".write": false,
    "installations": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['installationUid'])",
        "installationUid": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9-]{36}$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null && data.child('members').child(auth.uid).val() == true && data.child('meta/expiresAt').val() > now",
        ".write": "auth != null && ((!data.exists() && newData.child('meta/hostUid').val() == auth.uid && newData.child('members').child(auth.uid).val() == true && !newData.child('queue').exists() && $room.matches(/^[a-f0-9]{32}$/)) || (!newData.exists() && data.child('meta/hostUid').val() == auth.uid))",
        ".validate": "newData.hasChildren(['meta','members','playback'])",
        "meta": {
          ".validate": "newData.hasChildren(['hostUid','expiresAt'])",
          "hostUid": {
            ".validate": "newData.isString() && (!data.exists() || newData.val() == data.val())"
          },
          "expiresAt": {
            ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 86400000 && (!data.exists() || newData.val() == data.val())"
          },
          "$other": {
            ".validate": false
          },
          "shortCode": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{6}$/)"
          },
          "protocolVersion": {
            ".validate": "newData.val() == 2"
          }
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('rooms').child($room).child('meta/expiresAt').val() > now",
            ".validate": "newData.isBoolean()"
          }
        },
        "queue": {
          "$song": {
            ".write": "auth != null && root.child('rooms').child($room).child('members').child(auth.uid).val() == true && root.child('rooms').child($room).child('meta/expiresAt').val() > now && ((!data.exists() && newData.child('addedBy').val() == auth.uid) || (!newData.exists() && (data.child('addedBy').val() == auth.uid || root.child('rooms').child($room).child('meta/hostUid').val() == auth.uid) && root.child('rooms').child($room).child('playback/songKey').val() != $song))",
            ".validate": "newData.hasChildren(['videoId','title','artist','durationMs','addedBy'])",
            "videoId": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{11}$/)"
            },
            "title": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "artist": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "durationMs": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400000"
            },
            "addedBy": {
              ".validate": "newData.isString()"
            },
            "$other": {
              ".validate": false
            },
            "sourceTrackId": {
              ".validate": "newData.isString() && newData.val().length <= 256"
            }
          }
        },
        "playback": {
          ".write": "auth != null && root.child('rooms').child($room).child('members').child(auth.uid).val() == true && root.child('rooms').child($room).child('meta/expiresAt').val() > now",
          ".validate": "newData.hasChildren(['songKey','playing','positionMs','effectiveAt','revision']) && ((!data.exists() && newData.child('revision').val() == 0) || newData.child('revision').val() > data.child('revision').val()) && ((newData.child('songKey').val() == '' && newData.child('playing').val() == false) || newData.parent().child('queue').child(newData.child('songKey').val()).exists())",
          "songKey": {
            ".validate": "newData.isString()"
          },
          "playing": {
            ".validate": "newData.isBoolean()"
          },
          "positionMs": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400000"
          },
          "effectiveAt": {
            ".validate": "newData.isNumber() && newData.val() >= now - 30000 && newData.val() <= now + 10000"
          },
          "revision": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$other": {
            ".validate": false
          },
          "buffering": {
            ".validate": "newData.isBoolean()"
          },
          "commandId": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "action": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          }
        },
        "$other": {
          ".validate": false
        },
        "ready": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('rooms').child($room).child('members').child(auth.uid).val() == true && root.child('rooms').child($room).child('meta/expiresAt').val() > now",
            ".validate": "newData.isString() && root.child('rooms').child($room).child('queue').child(newData.val()).exists()"
          }
        }
      }
    },
    "friendInvites": {
      "$code": {
        ".read": "auth != null && data.child('expiresAt').val() > now",
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() == auth.uid && $code.matches(/^[a-f0-9]{32}$/)) || (!newData.exists() && data.child('ownerUid').val() == auth.uid))",
        ".validate": "newData.hasChildren(['ownerUid','expiresAt'])",
        "ownerUid": {
          ".validate": "newData.isString()"
        },
        "expiresAt": {
          ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 604800000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "friendRequests": {
      "$target": {
        ".read": "auth != null && auth.uid == $target",
        "$from": {
          ".read": "auth != null && auth.uid == $from",
          ".write": "auth != null && $target != $from && ((!newData.exists() && (auth.uid == $target || auth.uid == $from)) || (auth.uid == $from && ((newData.child('inviteCode').isString() && root.child('friendInvites').child(newData.child('inviteCode').val()).child('ownerUid').val() == $target && root.child('friendInvites').child(newData.child('inviteCode').val()).child('expiresAt').val() > now) || (newData.child('roomCode').isString() && root.child('rooms').child(newData.child('roomCode').val()).child('members').child(auth.uid).val() == true && root.child('rooms').child(newData.child('roomCode').val()).child('members').child($target).val() == true && root.child('rooms').child(newData.child('roomCode').val()).child('meta/expiresAt').val() > now))))",
          ".validate": "newData.hasChildren(['createdAt']) && (newData.hasChild('inviteCode') || newData.hasChild('roomCode'))",
          "inviteCode": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)"
          },
          "roomCode": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 1000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$friend": {
          ".read": "auth != null && auth.uid == $friend",
          ".write": "auth != null && $uid != $friend && ((!newData.exists() && (auth.uid == $uid || auth.uid == $friend)) || (newData.val() == true && ((auth.uid == $uid && root.child('friendRequests').child($uid).child($friend).exists()) || (auth.uid == $friend && root.child('friendRequests').child($friend).child($uid).exists()))))",
          ".validate": "newData.isBoolean() && newData.val() == true"
        }
      }
    },
    "roomInvites": {
      "$target": {
        ".read": "auth != null && auth.uid == $target",
        "$from": {
          ".write": "auth != null && ((!newData.exists() && (auth.uid == $target || auth.uid == $from)) || (auth.uid == $from && $target != $from && root.child('friends').child($from).child($target).val() == true && root.child('friends').child($target).child($from).val() == true && newData.child('roomCode').isString() && root.child('rooms').child(newData.child('roomCode').val()).child('members').child($from).val() == true && root.child('rooms').child(newData.child('roomCode').val()).child('meta/expiresAt').val() > now))",
          ".validate": "newData.hasChildren(['roomCode','createdAt'])",
          "roomCode": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 1000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "roomLookups": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid && newData.exists() && (!data.exists() || now >= data.child('requestedAt').val() + 2000)",
        ".validate": "newData.hasChildren(['code','requestedAt'])",
        "code": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{6}$/)"
        },
        "requestedAt": {
          ".validate": "newData.isNumber() && newData.val() >= now - 1000 && newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "roomCodes": {
      "$code": {
        ".read": "auth != null && ((data.child('ownerUid').val() == auth.uid) || (root.child('roomLookups').child(auth.uid).child('code').val() == $code && root.child('roomLookups').child(auth.uid).child('requestedAt').val() >= now - 10000 && (!data.exists() || data.child('expiresAt').val() > now)))",
        ".write": "auth != null && $code.matches(/^[0-9]{6}$/) && ((!newData.exists() && data.child('ownerUid').val() == auth.uid) || (newData.exists() && (!data.exists() || data.child('expiresAt').val() <= now) && newData.child('ownerUid').val() == auth.uid && root.child('rooms').child(newData.child('roomId').val()).child('meta/hostUid').val() == auth.uid && root.child('rooms').child(newData.child('roomId').val()).child('meta/shortCode').val() == $code && root.child('rooms').child(newData.child('roomId').val()).child('meta/expiresAt').val() == newData.child('expiresAt').val()))",
        ".validate": "newData.hasChildren(['roomId','ownerUid','expiresAt'])",
        "roomId": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)"
        },
        "ownerUid": {
          ".validate": "newData.isString()"
        },
        "expiresAt": {
          ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 86400000"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
